{
  "capabilities": {
    "urn:ietf:params:jmap:core": {
      "maxSizeUpload": 50000000,
      "maxConcurrentUpload": 4,
      "maxConcurrentRequests": 8,
      "maxCallsInRequest": 16,
      "maxObjectsInGet": 500,
      "maxObjectsInSet": 500,
      "collationAlgorithms": [
        "i;ascii-casemap"
      ]
    },
    "urn:ietf:params:jmap:mail": {
      "maxMailboxesPerEmail": 10,
      "maxKeywordsPerEmail": 100
    },
    "urn:ietf:params:jmap:submission": {},
    "urn:ietf:params:jmap:websocket": {
      "url": "wss://mail.example.com/jmap/ws",
      "supportsPush": true
    }
  },
  "accounts": {
    "u1": {
      "name": "Personal",
      "isPersonal": true,
      "isReadOnly": false,
      "accountCapabilities": {
        "urn:ietf:params:jmap:mail": {
          "maxMailboxesPerEmail": 10
        },
        "urn:ietf:params:jmap:submission": {}
      }
    }
  },
  "primaryAccounts": {
    "urn:ietf:params:jmap:mail": "u1",
    "urn:ietf:params:jmap:submission": "u1"
  },
  "username": "alice@example.com",
  "apiUrl": "https://mail.example.com/jmap/api",
  "downloadUrl": "https://mail.example.com/jmap/download/{accountId}/{blobId}/{name}?type={type}",
  "uploadUrl": "https://mail.example.com/jmap/upload/{accountId}",
  "eventSourceUrl": "https://mail.example.com/jmap/eventsource",
  "state": "session-state-websocket"
}
